{
  "name": "pc-video-player",
  "version": "1.0.1",
  "description": "Modern PC Video Player Client based on Electron, Vue 3, and ArtPlayer",
  "author": "Nexus Team <nexus@example.com>",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:win": "node -e \"try{require('child_process').execSync('taskkill /F /IM NexusPlayer.exe /T 2>nul')}catch(e){}\" && vite build && electron-builder --win portable dir --publish always",
    "build:mac": "vite build && electron-builder --mac zip dmg dir --publish always",
    "build:all": "vite build && electron-builder --win portable dir --mac zip dmg dir --publish always",
    "cap:sync": "vite build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Joker-smile/Nexus-Player.git"
  },
  "build": {
    "appId": "com.nexus.player",
    "productName": "NexusPlayer",
    "publish": [
      {
        "provider": "github",
        "owner": "Joker-smile",
        "repo": "Nexus-Player",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "!node_modules/@capacitor/android/**/*",
      "!node_modules/@capacitor/app/android/**/*",
      "!node_modules/@capacitor/core/android/**/*",
      "!node_modules/@capacitor/app/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-portable.${ext}",
      "useZip": true
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.entertainment"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "artplayer": "^5.1.6",
    "hls.js": "^1.5.8",
    "lucide-vue-next": "^0.344.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vue-tsc": "^2.0.6",
    "wait-on": "^7.2.0"
  }
}
